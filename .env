# ---- Shiprocket shipping (Admin → Shipping) ----
# Shiprocket → Settings → API → Configure → "Create an API User". Use a NEW email address (not your main Shiprocket login).
# These stay on the server only. Never commit or share ".env".
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact name of your pickup address: Shiprocket → Settings → Pickup Addresses (the default one is usually "Primary").
SHIPROCKET_PICKUP=Primary
# Optional: instant status updates. Any long random text; use the same text as the "x-api-key" header when you add the webhook
# (URL: https://your-domain/api/shiprocket/webhook) in Shiprocket → Settings → API → Webhooks.
SHIPROCKET_WEBHOOK_TOKEN=
# Optional parcel defaults (also editable in Admin → Shipping): SHIP_UNIT_WEIGHT_KG=0.3  SHIP_LENGTH_CM=15  SHIP_BREADTH_CM=12  SHIP_HEIGHT_CM=10
