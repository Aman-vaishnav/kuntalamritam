CONTACT_PHONE=
CONTACT_ADDRESS=
CONTACT_HOURS=Mon – Sat, 10:00 AM – 6:00 PM IST
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_X=
# WhatsApp: uses CONTACT_PHONE (10-digit Indian numbers get +91) unless you set a full link, e.g. https://wa.me/919876543210
