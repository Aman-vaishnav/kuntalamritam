# Copy this file to ".env" and fill it in. NEVER commit or share ".env" (it holds your email password).
# Without SMTP_HOST the site runs in demo mode: the sign-up code is shown on screen and in the server terminal.

# ---- Email via Nodemailer (sign-up code, forgot-password code, password-changed alerts, newsletter) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# 465 → SMTP_SECURE=tls   |   587 → SMTP_SECURE=starttls
SMTP_SECURE=tls
SMTP_USER=yourname@gmail.com
# Gmail: create an "App password" (Google Account → Security → 2-Step Verification → App passwords)
SMTP_PASS=your-16-letter-app-password
MAIL_FROM=Kuntalamritam <yourname@gmail.com>
# Optional: where customer replies go, and a shortcut instead of SMTP_HOST/PORT (e.g. SMTP_SERVICE=gmail)
# MAIL_REPLY_TO=care@your-domain.in
# SMTP_SERVICE=gmail

# Public address of the website. Used for the links inside emails (confirm subscription, unsubscribe, reset).
# REQUIRED on a live server, e.g. https://www.your-domain.in   (dev: leave empty, the request address is used)
SITE_URL=

# ---- Admin panel (open /admin) ----
# The first start creates this admin account. Use a strong password (8+ chars, upper, lower, number, symbol).
# In development, if these are empty, a DEMO admin is created: admin@kuntalamritam.in / Admin@1234 (never in production).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 1 = new orders wait at "Order placed" until you change their status in the admin panel (use this on a live store).
# Leave empty to keep the demo timer that auto-advances orders every few minutes.
MANUAL_ORDERS=
# TZ_OFFSET_MIN=330      # minutes from UTC used for daily charts (330 = India)

# ---- Optional ----
# MAIL_RATE_MS=250       # pause between newsletter emails (Gmail allows ~500/day; a transactional provider such as Brevo/SES/SendGrid is better for big lists)
# SMTP_MAX_CONNECTIONS=3 # parallel SMTP connections in the pool
# OTP_TTL_SEC=600        # how long a code stays valid (default 10 minutes)
# OTP_RESEND_SEC=30      # wait time before "Resend code" (default 30 s)
# NODE_ENV=production    # set on a live server: never show the code on screen
# TRUST_PROXY=1          # set if the site is behind nginx/Cloudflare so rate limits use the visitor's real IP

# ---- Razorpay online payments (UPI, cards, netbanking, wallets) ----
# Razorpay Dashboard → Account & Settings → API keys. Use rzp_test_… keys while testing, rzp_live_… when you go live.
# The KEY SECRET stays on the server only – it is never sent to the browser. Never commit or share ".env".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret = any long random text (e.g. run: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))").
# Put the same text in Razorpay Dashboard → Webhooks. It lets Razorpay confirm a payment even if the customer closes the tab.
RAZORPAY_WEBHOOK_SECRET=
# LIVE checklist: https site + SITE_URL=https://your-domain + NODE_ENV=production + TRUST_PROXY=1 (behind nginx/Cloudflare) + live keys.

# ---- Contact details & social media (shown in the footer and on the Contact page) ----
# Full https:// links to your pages. Leave empty and the icon links to the platform's home page.
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_ADDRESS=
CONTACT_HOURS=Mon – Sat, 10:00 AM – 6:00 PM IST
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_X=
# WhatsApp: uses CONTACT_PHONE (10-digit Indian numbers get +91) unless you set a full link, e.g. https://wa.me/919876543210
SOCIAL_WHATSAPP=

# ---- Shiprocket shipping (Admin → Shipping) ----
# Shiprocket → Settings → API → Configure → "Create an API User". Use a NEW email address (not your main Shiprocket login).
# These stay on the server only. Never commit or share ".env".
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact name of your pickup address: Shiprocket → Settings → Pickup Addresses (the default one is usually "Primary").
SHIPROCKET_PICKUP=Primary
# Optional: instant status updates. Any long random text; use the same text as the "x-api-key" header when you add the webhook
# (URL: https://your-domain/api/shiprocket/webhook) in Shiprocket → Settings → API → Webhooks.
SHIPROCKET_WEBHOOK_TOKEN=
# Optional parcel defaults (also editable in Admin → Shipping): SHIP_UNIT_WEIGHT_KG=0.3  SHIP_LENGTH_CM=15  SHIP_BREADTH_CM=12  SHIP_HEIGHT_CM=10

# ---- Gallery videos ----
# Largest video file (in MB) that can be uploaded in Admin → Gallery. Long videos are better added as a YouTube link.
# GALLERY_VIDEO_MAX_MB=50
